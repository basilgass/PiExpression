{
  "name": "piexpression",
  "version": "0.1.1",
  "description": "An expression parser and numerical expression builder",
  "type": "module",
  "main": "dist/piexpression.js",
  "module": "dist/piexpression.js",
  "types": "types/intex.d.ts",
  "exports": {
    ".": {
      "import": "./dist/piexpression.js",
      "require": "./dist/piexpression.js"
    }
  },
  "files": [
    "dist",
    "types"
  ],
  "scripts": {
    "dev": "vite serve",
    "test": "vitest",
    "build": "tsc --p ./tsconfig-build.json && vite build",
    "preview": "vite preview",
    "docs": "typedoc",
    "dependency-cruise": "dependency-cruise -T dot -x node_modules -v -- src/index.ts  | dot -T svg > dependencies.svg"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/eslint__js": "^9.14.0",
    "autoprefixer": "^10.4.22",
    "dependency-cruiser": "^17.3.2",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.49.0",
    "vite": "^7.2.7",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.0.15"
  }
}
