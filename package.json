{
  "name": "piexpression",
  "version": "0.1.4",
  "description": "An expression parser and numerical expression builder",
  "type": "module",
  "main": "dist/piexpression.js",
  "module": "dist/piexpression.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/piexpression.js",
      "require": "./dist/piexpression.js"
    }
  },
  "./types/index.d.ts": "./types/index.d.ts",
  "files": [
    "dist",
    "types"
  ],
  "scripts": {
    "dev": "vite serve",
    "test": "vitest",
    "build": "tsc --p ./tsconfig-build.json && vite build",
    "preview": "vite preview",
    "docs": "typedoc",
    "dependency-cruise": "dependency-cruise -T dot -x node_modules -v -- src/index.ts  | dot -T svg > dependencies.svg"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.22",
    "dependency-cruiser": "^17.3.2",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
